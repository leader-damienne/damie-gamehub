# Clé API du Developer Portal Pi (Mainnet ou Testnet selon le projet).
# develop.pinet.com → votre app → API Key
PI_API_KEY=

# true = Testnet / Sandbox local
# false = Mainnet (Pi Browser production)
NEXT_PUBLIC_PI_SANDBOX=true

# URL publique HTTPS (domaine Cloudflare)
NEXT_PUBLIC_APP_URL=https://damiegamehub.com

# Optionnel — secret de session (par défaut dérivé de PI_API_KEY)
SESSION_SECRET=
