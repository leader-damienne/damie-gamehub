# Clé Testnet — utilisée pour dépôts et retraits (Test-π)
PI_API_KEY=
# Optionnel, sinon PI_API_KEY est utilisée sur le Testnet
PI_API_KEY_TESTNET=

# Clé Mainnet (inutilisée tant que l’app reste en Test-π)
PI_API_KEY_MAINNET=

# true = Testnet / Test-π (dépôts et retraits)
NEXT_PUBLIC_PI_SANDBOX=true

# URL publique HTTPS (domaine Cloudflare)
NEXT_PUBLIC_APP_URL=https://damiegamehub.com

# Optionnel — secret de session (par défaut dérivé de PI_API_KEY)
SESSION_SECRET=

# Graine secrète du App Wallet (commence par S, 56 caractères). Secret Cloudflare, jamais dans git.
# Obligatoire pour les retraits A2U. Créez le wallet dans develop.pinet.com (pas None), alimentez-le.
PI_WALLET_SEED=
# Optionnel, sinon PI_WALLET_SEED est utilisée
PI_WALLET_SEED_MAINNET=
PI_WALLET_SEED_TESTNET=

# Persistance des soldes : binding KV nommé DAMIE_KV (onglet Bindings).
# Alternative REST si le binding n’est pas disponible :
# CF_ACCOUNT_ID=
# CF_KV_NAMESPACE_ID=
# CF_API_TOKEN=
